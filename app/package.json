{
  "name": "stud-voice-bias-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STUD - Confirmation Bias x Voice Type Study App",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun run build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/lib/server/db/seed.ts",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^13.0.3",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.30.6",
    "postcss": "^8.5.15",
    "svelte": "^5.55.8",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "zod": "^3.25.76"
  }
}
